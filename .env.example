# Variables d'environnement Firebase — à renseigner dans Netlify > Site settings > Environment variables
# Copier ce fichier en .env.local pour le dev local

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Pour les Netlify Functions (Firebase Admin SDK) — Service Account JSON encodé en base64
FIREBASE_SERVICE_ACCOUNT_BASE64=

# Identifiants administrateur privés (ignorés par Git via .gitignore)
# À renseigner dans .env.local (local) et dans Netlify (production)
ADMIN_EMAIL=
ADMIN_PASSWORD=
